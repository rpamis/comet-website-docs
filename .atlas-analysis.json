  "keyFeatures": [
    "Five-phase automated development workflow: open → design → build → verify → archive",
    "Auto-detection of current workflow phase on resume — no lost context",
    "Guard scripts enforce phase exit conditions before advancing",
    "Decoupled YAML state files (.comet.yaml) for reliable breakpoint recovery",
    "Support for 28 AI coding platforms including Claude Code, Cursor, Windsurf, GitHub Copilot, and more",
    "Project-level and global installation scopes",
    "English and Chinese skill language support",
    "Preset paths for hotfix and tweak changes (skip brainstorming phases)",
    "Automated archive sync from delta specs to main specs",
    "comet-handoff.sh generates SHA256-traced context packages for design-to-build handoff"
  ],
  "publicApiSurface": [
    "comet init [path] --yes --scope --skip-existing --overwrite --json",
    "comet status [path] --json",
    "comet doctor [path] --json --scope",
    "comet update [path] --json --language --scope",
    "/comet (AI skill — auto-detects phase and dispatches)",
    "/comet-open (AI skill — Phase 1: open a change)",
    "/comet-design (AI skill — Phase 2: deep design)",
    "/comet-build (AI skill — Phase 3: plan and build)",
    "/comet-verify (AI skill — Phase 4: verify and finish)",
    "/comet-archive (AI skill — Phase 5: archive)",
    "/comet-hotfix (AI skill — preset: quick bug fix)",
    "/comet-tweak (AI skill — preset: small change)",
    "comet-guard.sh <change-name> <phase> [--apply]",
    "comet-state.sh init|set|get|check|scale|transition",
    "comet-handoff.sh [--full]",
    "comet-archive.sh <change-name> [--dry-run]",
    "comet-yaml-validate.sh",
    "comet-env.sh (script discovery helper)",
    "npx skills add rpamis/comet (OpenClaw/Hermes platform install)"
  ]
}
