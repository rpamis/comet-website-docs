# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Agent instruction files (not docs pages; contain non-MDX syntax)
AGENTS.md
CLAUDE.md

# Local agent files and CSS experiments must not become site assets.
.codex/

# Draft content
drafts/
*.draft.mdx

.idea/
